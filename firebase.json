{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "source": "functions", 
    "codebase": "default",
    "runtime": "nodejs18",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint"
    ]
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "snippets/**.dart",
        "headers": [
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": { "port": 0 },
    "firestore": { "port": 0 },
    "functions": { "port": 0 },
    "database": { "port": 0 },
    "hosting": { "port": 0 },
    "pubsub": { "port": 0 },
    "storage": { "port": 0 },
    "eventarc": { "port": 0 },
    "ui": {
      "enabled": true,
      "port": 0
    },
    "singleProjectMode": true
  },
  "extensions": {}
}
