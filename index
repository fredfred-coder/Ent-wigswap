// Importation des modules nécessaires
const functions = require('firebase-functions');
const admin = require('firebase-admin');

// Initialisation Firebase
admin.initializeApp();

// Fonction personnalisée pour extraire des données de la réponse JSON
function extractPostResponseData(jsonResponse) {
  try {
    const response = JSON.parse(jsonResponse);
    const waveLaunchUrl = response["waveLaunchUrl"];
    const paymentId = response["paymentId"];
    console.log("Données extraites :", { waveLaunchUrl, paymentId });
    return { waveLaunchUrl, paymentId };
  } catch (error) {
    console.error("Erreur lors de l'extraction des données JSON :", error);
    return null;
  }
}

// Fonction Firebase pour créer une session de paiement
exports.createPaymentSession = functions.https.onRequest(async (req, res) => {
  console.log("==> Fonction createPaymentSession déclenchée");

  try {
    console.log("Méthode de requête :", req.method);

    if (req.method !== "POST") {
      console.warn("Méthode non autorisée :", req.method);
      return res.status(405).send({ error: "Méthode non autorisée" });
    }

    // Étape 1 : Récupération des paramètres
    const { amount, currency, userId, phoneNumber } = req.body;
    console.log("Paramètres reçus :", { amount, currency, userId, phoneNumber });

    // Validation des paramètres
    if (!amount || !currency || !userId || !phoneNumber) {
      console.error("Paramètres manquants ou invalides :", req.body);
      return res.status(400).send({ error: "Paramètres manquants ou invalides" });
    }

    // Étape 2 : Génération de l'ID du document
    const paymentId = admin.firestore().collection('paiement').doc().id;
    console.log("ID de paiement généré :", paymentId);

    // Étape 3 : Préparation des données pour Firestore
    const waveLaunchUrl = `https://pay.wave.com/c/${paymentId}?a=${amount}&c=${currency}&m=${encodeURIComponent(phoneNumber)}`;
    const paymentData = {
      amount,
      currency,
      userId,
      phoneNumber,
      waveLaunchUrl,
      status: 'pending',
      createdAt: admin.firestore.Timestamp.now(),
    };
    console.log("Données prêtes pour Firestore :", paymentData);

    // Étape 4 : Enregistrement dans Firestore
    await admin.firestore().collection('paiement').doc(paymentId).set(paymentData);
    console.log("Document créé avec succès dans Firestore :", paymentId);

    // Étape 5 : Extraction des données via la fonction personnalisée
    const jsonResponse = JSON.stringify({
      waveLaunchUrl: paymentData.waveLaunchUrl,
      paymentId: paymentId,
    });
    const extractedData = extractPostResponseData(jsonResponse);
    console.log("Données extraites après traitement :", extractedData);

    // Réponse à l'utilisateur
    return res.status(201).send({
      paymentId: extractedData.paymentId,
      waveLaunchUrl: extractedData.waveLaunchUrl,
    });
  } catch (error) {
    console.error("Erreur dans createPaymentSession :", error.message, error.stack);
    return res.status(500).send({ error: "Erreur interne" });
  }
});

