// Importation des modules nécessaires
const functions = require("firebase-functions");
const admin = require("firebase-admin");
const cors = require("cors")({ origin: true });
admin.initializeApp();

// Fonction Firebase HTTP pour la création d'une session de paiement
exports.createPaymentSession = functions.region("us-central1").https.onRequest(async (req, res) => {
  console.log("==> Fonction createPaymentSession déclenchée");

  try {
    console.log("Méthode de requête :", req.method);

    if (req.method !== "POST") {
      console.warn("Méthode non autorisée :", req.method);
      return res.status(405).send({ error: "Méthode non autorisée" });
    }

    const { amount, currency, userId, phone_number, success_url, error_url } = req.body;

    console.log("Paramètres reçus :", { amount, currency, userId, phone_number });

    // Validation des paramètres requis
    if (!amount || !currency || !userId || !phone_number) {
      console.error("Paramètres manquants ou invalides :", req.body);
      return res.status(400).send({ error: "Paramètres manquants ou invalides" });
    }

    // Génération de l'ID de paiement
    const paymentId = admin.firestore().collection("paiements").doc().id;
    console.log("ID de paiement généré :", paymentId);

    // Construction de l'URL de paiement Wave
    const waveLaunchUrl = `https://pay.wave.com/c/${paymentId}?a=${amount}&c=${currency}`;
    console.log("URL de paiement Wave générée :", waveLaunchUrl);

    // Préparation des données pour Firestore
    const paymentData = {
      userId,
      phone_number,
      amount,
      currency,
      success_url,
      error_url,
      wave_launch_url: waveLaunchUrl,
      status: "pending",
      createdAt: admin.firestore.Timestamp.now(),
    };

    console.log("Données prêtes pour Firestore :", paymentData);

    // Enregistrement dans Firestore
    const ref = admin.firestore().collection("paiements").doc(paymentId);
    await ref.set(paymentData);
    console.log("Paiement enregistré avec succès dans Firestore :", paymentId);

    // Réponse avec l'URL générée
    return res.status(201).send({
      paymentId,
      wave_launch_url: waveLaunchUrl,
    });
  } catch (error) {
    console.error("Erreur dans createPaymentSession :", error.message, error.stack);
    return res.status(500).send({ error: "Erreur interne" });
  }
});

// Fonction personnalisée pour extraire des données spécifiques de la réponse JSON
function extractPostResponseData(jsonResponse) {
  try {
    const response = JSON.parse(jsonResponse);
    const waveLaunchUrl = response["wave_launch_url"];
    const paymentId = response["paymentId"];
    console.log("Données extraites :", { waveLaunchUrl, paymentId });
    return { waveLaunchUrl, paymentId };
  } catch (error) {
    console.error("Erreur lors de l'extraction des données JSON :", error);
    return null;
  }
}

// Exemple d'utilisation de la fonction extractPostResponseData
const exampleJsonResponse = JSON.stringify({
  wave_launch_url: "https://pay.wave.com/c/example?a=1000&c=XOF",
  paymentId: "example123",
});
const extractedData = extractPostResponseData(exampleJsonResponse);
console.log("Exemple de données extraites :", extractedData);

