const { onRequest } = require("firebase-functions/v2/https");
const { logger } = require("firebase-functions");
const admin = require("firebase-admin");
const Joi = require("joi");
const fetch = require("node-fetch");

// Initialisation de Firebase Admin SDK
if (!admin.apps.length) {
    admin.initializeApp();
}

// Configuration des environnements multiples
const CONFIG = {
    WAVE_BASE_URL: process.env.WAVE_BASE_URL || "https://pay.wave.com",
    AUTH_KEY: process.env.AUTH_KEY || "secret-key",
    WEBHOOK_SECRET: process.env.WEBHOOK_SECRET || "webhook-secret-key",
    FETCH_TIMEOUT: parseInt(process.env.FETCH_TIMEOUT) || 10000, // Timeout configurable
};

// Vérification des clés essentielles en production
if (process.env.NODE_ENV === "production" && (!CONFIG.WAVE_BASE_URL || !CONFIG.AUTH_KEY || !CONFIG.WEBHOOK_SECRET)) {
    throw new Error("Les variables d'environnement WAVE_BASE_URL, AUTH_KEY et WEBHOOK_SECRET sont requises en production.");
}

// Constantes pour les statuts de paiement
const PAYMENT_STATUSES = {
    PENDING: "pending",
    COMPLETED: "completed",
    FAILED: "failed",
    CANCELED: "canceled",
};

// Transitions de statut valides
const VALID_STATUS_TRANSITIONS = {
    pending: ["completed", "failed", "canceled"],
    completed: [],
    failed: ["pending"],
    canceled: ["pending"],
};

/**
 * Valide les transitions de statut.
 * @param {string} currentStatus - Le statut actuel.
 * @param {string} newStatus - Le nouveau statut.
 * @returns {boolean} - True si la transition est valide, sinon false.
 */
const isValidTransition = (currentStatus, newStatus) => {
    return VALID_STATUS_TRANSITIONS[currentStatus]?.includes(newStatus) || false;
};

/**
 * Valide les paramètres d'entrée pour la création d'une session de paiement.
 * @param {Object} body - Les données d'entrée.
 * @returns {Joi.ValidationResult} - Le résultat de la validation.
 */
const validateInput = (body) => {
    const schema = Joi.object({
        amount: Joi.number().positive().required(),
        currency: Joi.string().length(3).required(),
        success_url: Joi.string().uri().required(),
        error_url: Joi.string().uri().required(),
        userId: Joi.string().required(),
    });
    const { error, value } = schema.validate(body);
    if (error) {
        logger.error(`Validation échouée : ${error.details[0].message}`, { body });
        throw new Error(error.details[0].message);
    }
    return value;
};

/**
 * Gère les erreurs et renvoie une réponse HTTP.
 * @param {Object} res - L'objet réponse HTTP.
 * @param {Error} error - L'erreur à gérer.
 * @param {number} statusCode - Le code de statut HTTP (par défaut 500).
 */
const handleError = (res, error, statusCode = 500) => {
    logger.error(`Erreur : ${error.message}`, { stack: error.stack, statusCode });
    res.status(statusCode).send({ status: "failed", code: statusCode, message: error.message });
};

/**
 * Wrapper pour fetch avec timeout.
 * @param {string} url - L'URL à appeler.
 * @param {Object} options - Les options de la requête.
 * @param {number} timeout - Le timeout en millisecondes (par défaut 10000).
 * @returns {Promise<Response>} - La réponse de la requête.
 */
const fetchWithTimeout = (url, options, timeout = CONFIG.FETCH_TIMEOUT) => {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), timeout);

    return fetch(url, { ...options, signal: controller.signal })
        .catch((error) => {
            if (error.name === 'AbortError') {
                throw new Error(`La requête a expiré après ${timeout} ms`);
            }
            throw error;
        })
        .finally(() => clearTimeout(timeoutId));
};

/**
 * Traite le paiement avec l'API Wave.
 * @param {string} userId - L'ID de l'utilisateur.
 * @param {number} amount - Le montant du paiement.
 * @param {string} currency - La devise du paiement.
 * @returns {Promise<Object>} - Le résultat du paiement.
 */
const processWavePayment = async (userId, amount, currency) => {
    logger.info(`Tentative de paiement direct pour userId=${userId}, amount=${amount}, currency=${currency}`);
    try {
        const response = await fetchWithTimeout(`${CONFIG.WAVE_BASE_URL}/execute-payment`, {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                Authorization: `Bearer ${CONFIG.AUTH_KEY}`,
            },
            body: JSON.stringify({ userId, amount, currency }),
        });

        if (!response.ok) {
            const errorText = await response.text();
            logger.error(`Erreur API Wave : ${errorText}`, { status: response.status });
            throw new Error(`Erreur API Wave : ${response.statusText}`);
        }

        const result = await response.json();
        logger.info(`Réponse de l'API Wave : ${JSON.stringify(result)}`);

        // Validation de la réponse de l'API Wave
        const waveResponseSchema = Joi.object({
            status: Joi.string().valid(...Object.values(PAYMENT_STATUSES)).required(),
            paymentId: Joi.string().required(),
            waveLaunchUrl: Joi.string().uri().required(),
        });
        const { error } = waveResponseSchema.validate(result);
        if (error) {
            throw new Error(`Réponse API Wave invalide : ${error.details[0].message}`);
        }

        return { status: result.status.toLowerCase(), paymentId: result.paymentId, waveLaunchUrl: result.waveLaunchUrl };
    } catch (error) {
        logger.error(`Erreur dans processWavePayment : ${error.message}`, { stack: error.stack });
        return { status: PAYMENT_STATUSES.FAILED };
    }
};

// Fonction principale : Création de session de paiement
exports.createPaymentSession = onRequest(async (req, res) => {
    logger.info("==> Fonction createPaymentSession déclenchée");
    try {
        // Validation des données d'entrée
        const { amount, currency, success_url, error_url, userId } = validateInput(req.body);
        logger.info(`Paramètres reçus : ${JSON.stringify({ amount, currency, userId })}`);

        // Récupération des données utilisateur
        const userDoc = await admin.firestore().collection("users").doc(userId).get();
        if (!userDoc.exists) {
            logger.error(`Utilisateur introuvable : userId=${userId}`);
            return handleError(res, new Error(`Utilisateur introuvable : userId=${userId}`), 404);
        }

        const { phone_number, username } = userDoc.data();
        if (!phone_number || !username) {
            logger.error(`Données utilisateur incomplètes : ${JSON.stringify(userDoc.data())}`);
            return handleError(
                res,
                new Error(`Données utilisateur incomplètes : userId=${userId}, phone_number ou username manquant`),
                400
            );
        }

        const paymentId = admin.firestore().collection("paiement").doc().id;

        // Traitement du paiement direct
        let paymentStatus = PAYMENT_STATUSES.PENDING;
        let waveLaunchUrl = `${CONFIG.WAVE_BASE_URL}/c/${paymentId}?a=${amount}&c=${currency}`;
        try {
            const paymentResult = await processWavePayment(userId, amount, currency);
            paymentStatus = paymentResult.status || PAYMENT_STATUSES.FAILED;
            waveLaunchUrl = paymentResult.waveLaunchUrl || waveLaunchUrl;
        } catch (error) {
            logger.error(`Erreur lors du traitement du paiement : ${error.message}`, { stack: error.stack });
            paymentStatus = PAYMENT_STATUSES.FAILED;
        }

        // Enregistrement des données de paiement
        const paymentData = {
            userId,
            phone_number,
            username,
            amount,
            currency,
            waveLaunchUrl,
            success_url,
            error_url,
            status: paymentStatus,
            statusHistory: [
                {
                    status: paymentStatus,
                    updatedAt: admin.firestore.FieldValue.serverTimestamp(),
                },
            ],
            createdAt: admin.firestore.FieldValue.serverTimestamp(),
        };
        await admin.firestore().collection("paiement").doc(paymentId).set(paymentData);

        // Réponse API
        return res.status(200).send({
            status: paymentStatus,
            waveLaunchUrl,
            paymentId,
        });
    } catch (error) {
        return handleError(res, error);
    }
});

// Fonction principale : Webhook pour les mises à jour des paiements
exports.paymentWebhook = onRequest(async (req, res) => {
    logger.info("==> Fonction paymentWebhook déclenchée");
    try {
        // Vérification de la clé d'authentification
        if (req.headers["x-wave-signature"] !== CONFIG.WEBHOOK_SECRET) {
            logger.error("Clé d'authentification invalide");
            return handleError(res, new Error("Clé d'authentification invalide"), 403);
        }

        // Validation des paramètres d'entrée
        const schema = Joi.object({
            paymentId: Joi.string().required(),
            status: Joi.string()
                .valid(...Object.values(PAYMENT_STATUSES))
                .required(),
        });

        const { error } = schema.validate(req.body);
        if (error) {
            logger.error(`Paramètres invalides : ${error.details[0].message}`);
            return handleError(res, new Error("Paramètres invalides"), 400);
        }

        const { paymentId, status } = req.body;

        // Mise à jour du statut du paiement avec transaction Firestore
        await admin.firestore().runTransaction(async (transaction) => {
            const paymentRef = admin.firestore().collection("paiement").doc(paymentId);
            const paymentDoc = await transaction.get(paymentRef);
            if (!paymentDoc.exists) {
                logger.error(`Paiement introuvable : paymentId=${paymentId}`);
                throw new Error(`Paiement introuvable : paymentId=${paymentId}`);
            }

            const currentStatus = paymentDoc.data().status;
            if (!isValidTransition(currentStatus, status)) {
                logger.error(`Transition de statut invalide : ${currentStatus} -> ${status}`);
                throw new Error("Transition de statut invalide");
            }

            transaction.update(paymentRef, {
                status,
                statusHistory: admin.firestore.FieldValue.arrayUnion({
                    status,
                    updatedAt: admin.firestore.FieldValue.serverTimestamp(),
                }),
            });
        });

        logger.info(`Mise à jour du paiement : paymentId=${paymentId}, nouveau statut=${status}`);
        return res.status(200).send({ status: "success", message: "Mise à jour réussie." });
    } catch (error) {
        return handleError(res, error);
    }
});
