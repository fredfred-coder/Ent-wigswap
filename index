const { onRequest } = require("firebase-functions/v2/https");
const { logger } = require("firebase-functions");
const axios = require("axios");
const admin = require("firebase-admin");

if (!admin.apps.length) {
  admin.initializeApp();
}

const WAVE_API_KEY = "wave_sn_prod_pRHzF_DXqLweifEdNSX9QIu3Arsi7Hlsb0AKOxlfogc8bVLZsiAILsS53GUnHJO2bXa_yzCoVGKyYv2C6sbga0jgbBN6JT8IaA";

// Custom Function : getPostResponseStatus
function getPostResponseStatus(apiResponse) {
  if (apiResponse && apiResponse.hasOwnProperty("status")) {
    return apiResponse["status"].toString();
  } else {
    return "unknown"; // Renvoie 'unknown' si 'status' est absent
  }
}

// Custom Function : extractPostResponseData
function extractPostResponseData(responseData) {
  try {
    const waveLaunchUrl = responseData["wave_launch_url"];
    const paymentId = responseData["paymentId"];
    if (!waveLaunchUrl || !paymentId) {
      throw new Error("Données manquantes dans la réponse de l'API");
    }
    logger.info("Données extraites :", { waveLaunchUrl, paymentId });
    return { waveLaunchUrl, paymentId };
  } catch (error) {
    logger.error("Erreur lors de l'extraction des données :", error.message);
    throw new Error("Impossible d'extraire les données de la réponse");
  }
}

// Fonction principale : createPaymentSession
exports.createPaymentSession = onRequest(async (req, res) => {
  try {
    logger.info("Requête reçue :", req.body);

    const { amount, currency, success_url, error_url, userId, phone_number } = req.body;

    if (!amount || !currency || !success_url || !error_url || !userId || !phone_number) {
      logger.error("Paramètres obligatoires manquants.");
      return res.status(400).send({ status: "failed", message: "Paramètres obligatoires manquants." });
    }

    logger.info("phone_number extrait :", phone_number);

    const paymentData = {
      amount,
      currency,
      success_url,
      error_url,
      phone_number,
    };

    logger.info("Données envoyées à Wave :", paymentData);

    const waveResponse = await axios.post(
      "https://api.wave.com/v1/checkout/sessions",
      paymentData,
      { headers: { Authorization: `Bearer ${WAVE_API_KEY}`, "Content-Type": "application/json" } }
    );

    if (waveResponse.status === 200 && waveResponse.data) {
      // Extraction des données avec extractPostResponseData
      const { waveLaunchUrl, paymentId } = extractPostResponseData(waveResponse.data);

      // Vérification du statut avec getPostResponseStatus
      const paymentStatus = getPostResponseStatus(waveResponse.data);

      logger.info("Statut extrait :", paymentStatus);

      if (paymentStatus === "success") {
        // Cas succès : Sauvegarde dans Firestore
        const paymentDataToSave = {
          userId,
          amount,
          currency,
          phone_number,
          waveLaunchUrl,
          paymentId,
          status: paymentStatus,
          createdAt: admin.firestore.FieldValue.serverTimestamp(),
        };

        logger.info("Données sauvegardées dans Firestore :", paymentDataToSave);

        await admin.firestore().collection("paiement").add(paymentDataToSave);

        return res.status(200).send({
          status: "success",
          waveLaunchUrl,
          paymentId,
        });
      } else {
        // Cas rejeté : retour d'un message d'échec
        logger.warn("Paiement rejeté avec statut :", paymentStatus);
        return res.status(400).send({
          status: "rejected",
          message: "Le paiement a été rejeté.",
          reason: `Statut renvoyé : '${paymentStatus}'`,
        });
      }
    } else {
      logger.error("Réponse inattendue de Wave :", waveResponse.data);
      return res.status(500).send({ status: "failed", message: "Réponse inattendue de Wave." });
    }
  } catch (error) {
    logger.error("Erreur :", error.message);
    return res.status(500).send({ status: "failed", message: "Erreur serveur.", error: error.message });
  }
});

