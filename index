const { onRequest } = require("firebase-functions/v2/https");
const { logger } = require("firebase-functions");
const admin = require("firebase-admin");
const Joi = require("joi");

if (!admin.apps.length) {
    admin.initializeApp();
}

// Configuration des environnements multiples
const CONFIG = {
    WAVE_BASE_URL: process.env.WAVE_BASE_URL || "https://pay.wave.com",
    AUTH_KEY: process.env.AUTH_KEY || "secret-key",
};

// Fonction personnalisée : Validation des paramètres d'entrée
const validateInput = (body) => {
    const schema = Joi.object({
        amount: Joi.number().positive().required(),
        currency: Joi.string().length(3).required(),
        success_url: Joi.string().uri().required(),
        error_url: Joi.string().uri().required(),
        userId: Joi.string().required(),
    });
    return schema.validate(body);
};

// Fonction personnalisée : Gestion des erreurs
const handleError = (res, error, statusCode = 500) => {
    logger.error(error.message);
    res.status(statusCode).send({ status: "failed", message: error.message });
};

// Fonction principale : Création de session de paiement
exports.createPaymentSession = onRequest(async (req, res) => {
    logger.info("==> Fonction createPaymentSession déclenchée");
    try {
        // Validation des données d'entrée
        const { error } = validateInput(req.body);
        if (error) {
            return handleError(res, new Error(error.details[0].message), 400);
        }

        const { amount, currency, success_url, error_url, userId } = req.body;

        // Récupération des informations utilisateur depuis Firestore
        const userDoc = await admin.firestore().collection("users").doc(userId).get();
        if (!userDoc.exists) {
            return handleError(res, new Error(`Utilisateur introuvable : userId=${userId}`), 404);
        }

        const userData = userDoc.data();
        const phone_number = userData.phone_number || null;
        const username = userData.username || null;

        if (!phone_number || !username) {
            return handleError(
                res,
                new Error(`Données utilisateur incomplètes : userId=${userId}, phone_number ou username manquant`),
                400
            );
        }

        // Génération de l'ID de paiement
        const paymentId = admin.firestore().collection("paiement").doc().id;

        // Tentative de paiement direct via API Wave
        let paymentStatus = "pending"; // Statut par défaut
        try {
            // Appel à une fonction simulée ou réelle pour effectuer le paiement
            const paymentResult = await processWavePayment(userId, amount, currency);
            paymentStatus = paymentResult.status; // Ex. "success" ou "failed"
        } catch (error) {
            logger.error(`Erreur lors de la tentative de paiement direct : ${error.message}`);
            paymentStatus = "failed";
        }

        // Génération de l'URL Wave pour fallback
        const waveLaunchUrl = `${CONFIG.WAVE_BASE_URL}/c/${paymentId}?a=${amount}&c=${currency}`;

        logger.info(`Session de paiement créée : paymentId=${paymentId}, statut=${paymentStatus}`);

        // Enregistrement dans Firestore
        await admin.firestore().collection("paiement").doc(paymentId).set({
            userId,
            phone_number,
            username,
            amount,
            currency,
            waveLaunchUrl,
            success_url,
            error_url,
            status: paymentStatus,
            statusHistory: [
                {
                    status: paymentStatus,
                    updatedAt: admin.firestore.FieldValue.serverTimestamp(),
                },
            ],
            createdAt: admin.firestore.FieldValue.serverTimestamp(),
        });

        // Réponse API
        return res.status(200).send({
            status: paymentStatus,
            waveLaunchUrl,
            paymentId,
            userId,
            phone_number,
            username,
        });
    } catch (error) {
        return handleError(res, error);
    }
});

// Fonction personnalisée : Traitement du paiement avec l'API Wave
const processWavePayment = async (userId, amount, currency) => {
    // Logique pour appeler l'API Wave et vérifier si le paiement est possible directement
    logger.info(`Tentative de paiement direct pour userId=${userId}, amount=${amount}, currency=${currency}`);
    // Simulez un appel API ou implémentez une logique réelle ici
    const isSuccess = Math.random() > 0.5; // Simulez un résultat aléatoire
    if (isSuccess) {
        return { status: "success" }; // Paiement accepté
    } else {
        throw new Error("Paiement échoué"); // Paiement refusé
    }
};

// Fonction principale : Webhook pour les mises à jour des paiements
exports.paymentWebhook = onRequest(async (req, res) => {
    logger.info("==> Fonction paymentWebhook déclenchée");
    try {
        // Vérification de la clé d'authentification
        if (req.headers["x-wave-signature"] !== CONFIG.AUTH_KEY) {
            return handleError(res, new Error("Clé d'authentification invalide"), 403);
        }

        const { paymentId, status } = req.body;
        if (!paymentId || !status) {
            return handleError(res, new Error("Paramètres manquants ou invalides"), 400);
        }

        const validStatuses = ["pending", "completed", "failed", "canceled"];
        if (!validStatuses.includes(status)) {
            return handleError(res, new Error(`Statut invalide : ${status}`), 400);
        }

        const paymentRef = admin.firestore().collection("paiement").doc(paymentId);
        const paymentDoc = await paymentRef.get();
        if (!paymentDoc.exists) {
            return handleError(res, new Error(`Paiement introuvable : paymentId=${paymentId}`), 404);
        }

        // Mise à jour du statut dans Firestore
        await paymentRef.update({
            status,
            statusHistory: admin.firestore.FieldValue.arrayUnion({
                status,
                updatedAt: admin.firestore.FieldValue.serverTimestamp(),
            }),
        });

        const { userId } = paymentDoc.data();
        logger.info(`Mise à jour du paiement pour userId=${userId}, statut=${status}`);

        return res.status(200).send({ status: "success", message: "Mise à jour réussie." });
    } catch (error) {
        return handleError(res, error);
    }
});

